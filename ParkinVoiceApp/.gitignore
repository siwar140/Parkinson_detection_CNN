# ============================================================
# MODÈLES IA - Règles générales
# ============================================================
# Ignorer par défaut TOUS les fichiers modèles (volumineux)
backend/models_ia/*.h5
backend/models_ia/*.keras
backend/models_ia/*.pkl

# MAIS autoriser explicitement le modèle legacy utilisé en production
!backend/models_ia/best_model_cnn_legacy.h5

